# --- Servidor (usado só por docker-compose.server.yml) ---
APP_DOMAIN=mahu.dominio.com
LETSENCRYPT_EMAIL=email@email.com
NGINX_PROXY_NETWORK=rede do proxy do nginx

# Origens extras de CORS, separadas por vírgula. Só é preciso para quem chamar a API
# direto; pelo nginx o frontend já está na mesma origem.
CARTA_CORS_ORIGINS=

# Índice CPU-only do torch: 2,05 GB de imagem em vez de 8,62 GB (veja README).
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# BACKEND_IMAGE / FRONTEND_IMAGE são opcionais: por padrão o compose builda local.
# BACKEND_IMAGE=carta-psicrometrica-backend
# FRONTEND_IMAGE=carta-psicrometrica-frontend
